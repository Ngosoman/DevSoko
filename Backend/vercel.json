{
  "builds": [
    {
      "src": "DevBackend/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 60 }
    }
  ],  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
        }
      ]
    }
  ],  "routes": [
    {
      "src": "/(.*)",
      "dest": "DevBackend/wsgi.py"
    }
  ]
}
